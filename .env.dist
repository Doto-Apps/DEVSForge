# Front
VITE_API_BASE_URL=http://localhost:3000/

# Development login defaults - Do not fill it out for production.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# Back - Database
DB_HOST=db
DB_USER=devsforge
DB_PASSWORD=test123
DB_NAME=devsforge
DB_PORT=5432
DB_DEBUG_QUERIES=0

# Back - Server
#PORT=3000

# Back - Authentication (REQUIRED - no defaults)
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Back - Logging
#LOG_DIR=/tmp/sim-logs/
#LOG_MODE=all

# Back - Kafka
KAFKA_ADDRESS=kafka:9092

# Back - Simulator
#SIMULATOR_COORDINATOR_PATH=/app/simulator/coordinator
#SIMULATOR_CMD=
SIMULATOR_ADDR=simulator:8080
#SIMULATOR_MODE=async

# Coordinator - Simulator
#SIMULATOR_PORT=8080

# Coordinator/Runner - Paths
#PATHS_RUNNER_CMD=/opt/devsforge/devsforge-runner
#PATHS_SIM_ROOT=/app
#INTEGRATIONS_DIR=/opt/devsforge/integrations
#SHARED_GO_DIR=/opt/devsforge/shared

# Coordinator - Kafka (optional override)
#KAFKA_TOPIC=

# Runner - Java (optional)
#JAVA_HOME=

# Internal LSP service authentication. Generate with task lsp:setup; never commit a real token.
LSP_INTERNAL_TOKEN=
LSP_ADDR=http://lsp:8090
# Browser origins allowed for LSP WebSocket connections (comma-separated).
LSP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
LSP_MAX_SESSIONS=6
LSP_MAX_JAVA_SESSIONS=2
LSP_IDLE_SECONDS=900
LSP_MAX_INITIALIZATIONS=2
LSP_MEMORY_LIMIT=4g
