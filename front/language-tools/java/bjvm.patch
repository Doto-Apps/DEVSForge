index 0000000..251c791
--- /dev/null
+++ b/natives/share/java/io/BrowserDirectory.c
@@ -0,0 +1,33 @@
+#include <natives-dsl.h>
+#include <cached_classdescs.h>
+#include <dirent.h>
+
+DECLARE_NATIVE("java/io", UnixFileSystem, list0, "(Ljava/io/File;)[Ljava/lang/String;") {
+  obj_header *path = LoadFieldObject(args[0].handle->obj, "java/lang/String", "path");
+  heap_string filename = AsHeapString(path, failed);
+  DIR *directory = opendir(filename.chars);
+  free_heap_str(filename);
+  if (!directory) return value_null();
+  char **entries = nullptr;
+  struct dirent *entry;
+  while ((entry = readdir(directory))) {
+    if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+    arrput(entries, strdup(entry->d_name));
+  }
+  closedir(directory);
+  handle *result = make_handle(thread, CreateObjectArray1D(thread, cached_classes(thread->vm)->string, arrlen(entries)));
+  if (result->obj) {
+    for (s32 i = 0; i < arrlen(entries); ++i) {
+      obj_header *name = MakeJStringFromModifiedUTF8(thread, (slice){entries[i], strlen(entries[i])}, false);
+      if (!name) break;
+      ReferenceArrayStore(result->obj, i, name);
+    }
+  }
+  for (s32 i = 0; i < arrlen(entries); ++i) free(entries[i]);
+  arrfree(entries);
+  obj_header *array = result->obj;
+  drop_handle(thread, result);
+  return (stack_value){.obj = array};
+failed:
+  return value_null();
+}
diff --git a/natives/share/sun/nio/ch/BrowserFileChannel.c b/natives/share/sun/nio/ch/BrowserFileChannel.c
new file mode 100644
index 0000000..b7465ce
--- /dev/null
+++ b/natives/share/sun/nio/ch/BrowserFileChannel.c
@@ -0,0 +1,39 @@
+#include <natives-dsl.h>
+#include <errno.h>
+#include <stdint.h>
+#include <unistd.h>
+
+static stack_value browser_read_result(vm_thread *thread, ssize_t result) {
+  if (result > 0) return (stack_value){.i = (s32)result};
+  if (result == 0) return (stack_value){.i = -1};
+  if (errno == EINTR) return (stack_value){.i = -3};
+  if (errno == EAGAIN) return (stack_value){.i = -2};
+  raise_vm_exception(thread, STR("java/io/IOException"), STR("File channel read failed"));
+  return value_null();
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, read0, "(Ljava/io/FileDescriptor;JI)I") {
+  int fd = LoadFieldInt(args[0].handle->obj, "fd");
+  return browser_read_result(thread, read(fd, (void *)(uintptr_t)args[1].l, args[2].i));
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, pread0, "(Ljava/io/FileDescriptor;JIJ)I") {
+  int fd = LoadFieldInt(args[0].handle->obj, "fd");
+  return browser_read_result(thread, pread(fd, (void *)(uintptr_t)args[1].l, args[2].i, args[3].l));
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, seek0, "(Ljava/io/FileDescriptor;J)J") {
+  int fd = LoadFieldInt(args[0].handle->obj, "fd");
+  off_t result = args[1].l < 0 ? lseek(fd, 0, SEEK_CUR) : lseek(fd, args[1].l, SEEK_SET);
+  if (result >= 0) return (stack_value){.l = result};
+  if (errno == EINTR) return (stack_value){.l = -3};
+  raise_vm_exception(thread, STR("java/io/IOException"), STR("File channel seek failed"));
+  return value_null();
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, closeIntFD, "(I)V") {
+  if (close(args[0].i) && errno != EINTR) {
+    raise_vm_exception(thread, STR("java/io/IOException"), STR("File channel close failed"));
+  }
+  return value_null();
+}
