{
  "id": "xdevs-python",
  "version": "1.0.0",
  "name": "xDEVS Python",
  "language": "python",
  "framework": "xDEVS",
  "extension": ".py",
  "legacyLanguage": "python",
  "default": true,
  "preparation": "xdevs-python",
  "wrapper": "wrapper",
  "modelPath": "model.py",
  "template": "templates/atomic.tmpl",
  "prompt": "ai/model.md",
  "context": [
    "wrapper/modeling"
  ],
  "servers": [
    {
      "id": "pyright",
      "command": "pyright-langserver",
      "args": [
        "--stdio"
      ],
      "allowedCommands": [
        "pyright.organizeimports"
      ]
    },
    {
      "id": "ruff",
      "command": "ruff",
      "args": [
        "server"
      ],
      "allowedCommands": [
        "ruff.applyAutofix",
        "ruff.applyOrganizeImports",
        "ruff.applyFormat"
      ]
    }
  ]
}
